API_BASE_URL=http://localhost:4000
AGENT_TOKEN=dev-agent-token
AGENT_ID=runner-local-1
INFERENCE_PROVIDER=lmstudio
# Override the base URL or model id resolved below, for either provider.
# INFERENCE_BASE_URL=
# INFERENCE_MODEL=
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# Set to the model id currently loaded in LM Studio to override the default.
LM_STUDIO_MODEL=google/gemma-4-e2b
INFERENCE_CHAT_TEMPERATURE=0.3
ARTIFACTS_DIR=../../artifacts
POLL_INTERVAL_MS=2000
LEASE_SECONDS=60
FETCH_POOL_CONCURRENCY=4
FETCH_POOL_MIN_INTERVAL_PER_DOMAIN_MS=2000
FETCH_ALLOWLIST_MODE=warn
INFERENCE_POOL_DEPTH=1
