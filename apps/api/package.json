{
  "name": "@framer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "tsc -b --clean && rm -rf dist",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "verify:queue": "tsx scripts/verify-job-queue.ts",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit false"
  },
  "dependencies": {
    "@framer/runner": "*",
    "@framer/schema": "*",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5"
  }
}
